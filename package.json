{
  "name": "jonny-hq-passes",
  "version": "1.0.0",
  "private": true,
  "description": "Apple Wallet pass web service (PassKit) for passes.jonny.to",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "db:init": "wrangler d1 execute passes --file=./schema.sql --remote",
    "db:init:local": "wrangler d1 execute passes --file=./schema.sql --local"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "node-forge": "1.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250726.0",
    "@types/node-forge": "1.3.11",
    "typescript": "5.5.4",
    "wrangler": "3.78.12"
  }
}
